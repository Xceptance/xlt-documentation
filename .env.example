# Environment Configuration for XLT Documentation Hub
# Copy this file to .env and set your secrets.
# NEVER commit the real .env file or real API keys to version control!

# Kilo Gateway API Key (app.kilo.ai/profile)
# Used by Blume's native Ask AI chat assistant to access google/gemini-3.8-flash
# via Bring Your Own Key (BYOK) with Google AI Studio.
KILO_API_KEY=your_kilo_api_key_here

# Optional: External Ask AI endpoint override (leave commented unless using an external proxy)
# ASK_AI_ENDPOINT=https://api.kilo.ai/api/gateway

