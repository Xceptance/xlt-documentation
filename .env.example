# Environment Configuration for XLT Documentation Hub
# Copy this file to .env and configure your local settings.
# NEVER commit the real .env file, Google project credentials, or real keys to Git!

# -----------------------------------------------------------------------------
# Blume Ask AI Configuration
# -----------------------------------------------------------------------------
# Endpoint of the Vertex AI Gateway proxy.
# In local development, the proxy runs at http://localhost:4000/v1
# In production, set this to the co-located or internal container proxy URL.
ASK_AI_ENDPOINT=http://localhost:4000/v1
ASK_AI_MODEL=gemini-2.5-flash

# Non-sensitive placeholder required by Blume's client schema validation.
# (Actual authentication is performed by the proxy via Google Cloud IAM).
ASK_AI_API_KEY=local-dev

# -----------------------------------------------------------------------------
# Google Cloud Platform (GCP) Configuration
# -----------------------------------------------------------------------------
# Google Cloud Project ID (used by the Vertex AI proxy to route/bill requests).
# Authentication is handled automatically via IAM (gcloud auth application-default login
# on your workstation, or the GCP Compute Metadata Server in Cloud Run / GCE).
GCP_PROJECT=your-gcp-project-id

# Vertex AI Location: defaults to 'global' for dynamic global capacity allocation.
# (Can be overridden to a regional endpoint, e.g. 'europe-west3', if desired).
GCP_LOCATION=global
