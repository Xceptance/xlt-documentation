# ==============================================================================
# Ask AI Service Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to `.env.development` or `.env.production` (or `.env`).
# NEVER commit real GCP project IDs, service account keys, or secrets to Git!
# All `.env*` files are ignored by .gitignore except for this `.env.example`.
# ==============================================================================

# Required: Google Cloud Platform Project ID
# Example: "antigravity-rbaumgarten" (dev) or "company-docs-prod" (prod)
# The deployment and cache scripts require this to be explicitly set.
GCP_PROJECT_ID="your-gcp-project-id"

# GCP Region where Cloud Function (Gen 2) will be hosted.
# Recommended European regions: "europe-west3" (Frankfurt) or "europe-west1" (Belgium)
GCP_REGION="europe-west3"

# Cloud Function name
# Example: "xlt-docs-ask-ai-dev" for development, "xlt-docs-ask-ai" for production
FUNCTION_NAME="xlt-docs-ask-ai"

# Allowed CORS Origins (comma-separated if multiple)
# Development: "http://localhost:4321,http://localhost:3000"
# Production: "https://docs.xceptance.com"
ALLOWED_ORIGIN="http://localhost:4321"

# Gemini Model version supporting Vertex AI Context Caching.
# Default: gemini-2.5-flash (or latest caching-capable model).
# IMPORTANT: Both refresh-cache.mjs and the deployed function MUST use the same model.
GEMINI_MODEL="gemini-2.5-flash"

# Vertex AI CachedContent resource ID (e.g. projects/.../cachedContents/...)
# Automatically updated by running `npm run refresh-cache`.
GEMINI_CACHE_NAME=""

