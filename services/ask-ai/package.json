{
  "name": "xlt-docs-ask-ai",
  "version": "1.0.0",
  "description": "Serverless Gemini Context Caching streaming proxy for Xceptance Documentation Ask AI",
  "type": "module",
  "main": "index.js",
  "scripts": {
